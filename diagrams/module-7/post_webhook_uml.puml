@startuml

actor transaction_service
queue kafka
participant payment_provider_service
participant webhook_service
database webhook_service_db

alt POST webhook-события

	transaction_service -> kafka : Публикация события [transaction];
	payment_provider_service <- kafka : Извлечение опубликованного события [transaction];
	payment_provider_service -> payment_provider_service : Обработка извлеченного запроса [transaction];
	
	payment_provider_service -> webhook_service : Отправка dto [webhook-transaction] POST /api/v1/webhook/payment-provider;
	
	webhook_service -> webhook_service : Валидация полученного dto [webhook-transaction] по токену доверенного источника;
	
	alt токен валиден
	
		webhook_service -> webhook_service : Проверка уведомления;
	
		alt уведомление известное
			
			alt @Transaction
			
				webhook_service -> webhook_service_db : Сохранить сущность [webhook-transaction] в таблицу payment_provider_callbacks, как необработанную;
			end
				
			alt @Transaction
			
				webhook_service -> webhook_service : Преобразование сохраненной сущности [webhook-transaction] в kafka-сообщение payment.status.updated;
				webhook_service -> kafka : Публикация полученного kafka-сообщения payment.status.updated;
				
				alt публикация успешна
					
					webhook_service -> webhook_service_db : Отметить сохраненную сущность [webhook-transaction], как обработанную;
					webhook_service --> payment_provider_service: Ответ 200 OK;
				
				else публикация неуспешна
					
					webhook_service -> webhook_service : Не отмечать сохраненную сущность [webhook-transaction], как обработанную;
					webhook_service --> payment_provider_service: Ответ 500 Server Error;
				end
					
			end
			
			transaction_service <- kafka : Извлечение полученного kafka-сообщения payment.status.updated;
			transaction_service -> transaction_service : Обработка извлеченного kafka-сообщения payment.status.updated;
			
		else уведомление неизвестное
		
			alt @Transaction
			
				webhook_service -> webhook_service_db : Сохранить сущность [webhook-transaction] в таблицу unknown_callbacks, как необработанную;
				webhook_service --> payment_provider_service: Ответ 400 Bad Request;
			end
		end
		
	else токен не валиден
	
		webhook_service --> payment_provider_service : Ответ 401 Unauthorized;
		payment_provider_service -> payment_provider_service : Отметить ошибку доставки [webhook-transaction], не фиксировать полученное событие [transaction] как обработнанное для повторной попытки обработки;
	end
end

@enduml