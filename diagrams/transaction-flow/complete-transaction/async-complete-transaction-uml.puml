@startuml

actor individuals_api

participant transaction_service

database transaction_service_db

queue kafka

alt complete_transaction	
	note right transaction_service
		{type} = [ deposit, withdrawal ];
		{status} = [ completed, failed, canceled ];
	end note

	kafka -> transaction_service : Fetch transaction.{type}.{status};
	transaction_service -> transaction_service_db : Update transaction, status = COMPLETED;
end

@enduml