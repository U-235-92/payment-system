@startuml

actor individuals_api

participant transaction_service
participant wallets_service

database transaction_service_db

queue kafka

alt create_transaction
	
	note right individuals_api
		type: [ deposit, withdrawal, transfer ]
	end note
	
	individuals_api -> transaction_service : POST /api/v1/transaction/{type}/confirm;
	
	transaction_service -> transaction_service : Create transaction, status = PENDING;
	transaction_service -> wallets_service : Credit balance;
	transaction_service -> kafka : Async processing;
	transaction_service --> individuals_api : Transaction confirmed, status = PENDING;
end

@enduml