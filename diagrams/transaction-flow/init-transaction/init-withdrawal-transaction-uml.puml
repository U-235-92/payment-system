@startuml

actor individuals_api

participant transaction_service
participant wallets_service

alt init_transaction
	
	note right individuals_api
		type: [ deposit, withdrawal, transfer ]
	end note
	
	individuals_api -> transaction_service : POST /api/v1/transaction/{type}/init;
	
	transaction_service -> transaction_service : Calculate transaction conditions;
	transaction_service -> wallets_service : Check wallet;
	transaction_service --> individuals_api : Fee, availability, conditions of withdrawal;
end

@enduml